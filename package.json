{
  "name": "@lo-ink/bot-sdk",
  "version": "0.5.2",
  "description": "Typed server-side bot client for LO",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "architecture": "depcruise --config .dependency-cruiser.cjs src",
    "format": "prettier --write .",
    "security": "npm audit --audit-level=high",
    "test:coverage": "c8 npm test",
    "policy": "node --test scripts/check-policy.test.mjs && node scripts/check-policy.mjs",
    "secrets": "node scripts/check-secrets.mjs",
    "ci": "make ci"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LO-ink/lo-bot-sdk.git"
  }
}
